root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,html,css,js,cjs,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Keep the upstream country snapshot and its copyright notice byte-for-byte.
[{cidrs.txt,Copyrights.txt}]
insert_final_newline = unset
trim_trailing_whitespace = false
end_of_line = unset
